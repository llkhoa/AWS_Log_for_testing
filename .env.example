# Region của pipeline
AWS_DEFAULT_REGION=ap-southeast-2

# Bỏ trống để dùng thông tin xác thực AWS hiện có trên máy.
# Chọn profile HOẶC điền cặp access key bên dưới.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Chỉ điền khi sử dụng credentials tạm thời.
AWS_SESSION_TOKEN=

# Bucket nguồn có sẵn và prefix cần đọc
S3_BUCKET=
S3_PREFIX=

# Glue Job; bỏ trống RUN_ID để lấy lần chạy gần nhất
GLUE_JOB_NAME=
GLUE_RUN_ID=

# Các log group phân cách bằng dấu phẩy; sửa nếu job dùng group tùy chỉnh
CLOUDWATCH_LOG_GROUPS=/aws-glue/jobs/error,/aws-glue/jobs/output
# Bỏ trống để dùng Glue Run ID
CLOUDWATCH_LOG_STREAM_PREFIX=

# Thư mục lưu log trên máy, đường dẫn tương đối tính từ thư mục chạy lệnh
PIPELINE_LOG_OUTPUT=pipeline_logs

# Dự phòng cho bước tích hợp Redshift sau này; script hiện CHƯA đọc các biến này
REDSHIFT_CLUSTER_IDENTIFIER=
REDSHIFT_WORKGROUP_NAME='
REDSHIFT_DATABASE='dev'
REDSHIFT_DB_USER=
REDSHIFT_SECRET_ARN=
